@echo off
REM Copy this file to secrets.local.bat (same folder) and fill in real values.
REM secrets.local.bat is gitignored — it will never be committed.
REM These are the exact same names used by the GitHub Actions secrets/variables
REM in .github/workflows/trading-engine.yml.

set ALPACA_ID=
set ALPACA_SECRET=
set POLYGON_KEY=
set TIINGO_KEY=
set TG_TOKEN=
set TG_ID=
set TRIAL_GITHUB_TOKEN=

REM Optional overrides (safe to leave blank to use built-in defaults):
set WATCHLIST=
set ENABLE_TRADING=true
set NOTIONAL_PER_TRADE=500
set MAX_POSITIONS=8
